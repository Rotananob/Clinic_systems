{
  "name": "clinic-patient-management",
  "version": "1.0.0",
  "description": "Production-grade Clinic Patient Management System with Next.js, NestJS, Prisma, and KHQR Payment Engine",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "start:backend": "npm --prefix backend run start:prod",
    "start:frontend": "npm --prefix frontend run start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "npm --prefix backend run prisma:generate",
    "db:push": "npm --prefix backend run prisma:push",
    "db:seed": "npm --prefix backend run prisma:seed"
  },
  "keywords": [
    "clinic",
    "patient-management",
    "nestjs",
    "nextjs",
    "prisma",
    "khqr"
  ],
  "author": "Rotananob",
  "license": "UNLICENSED"
}
