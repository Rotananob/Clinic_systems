                android:startX="48"
                android:startY="26"
                android:endX="64"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#2DD4BF"/>
                <item android:offset="1.0" android:color="#006A6A"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- Cross Horizontal Bar -->
    <path
        android:pathData="M26,48 h56 a4,4 0 0,1 4,4 v12 a4,4 0 0,1 -4,4 h-56 a4,4 0 0,1 -4,-4 v-12 a4,4 0 0,1 4,-4 z">
