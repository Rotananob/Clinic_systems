# ClinicOS Production Multi-Tenant Environment Template
# Copy this file to .env.production and fill in secure values before deployment

# 1. Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_very_secure_random_db_password_64char
POSTGRES_DB=clinic_systems

# Direct URL for Prisma migrations (bypasses PgBouncer session preparation)
MIGRATION_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/clinic_systems?schema=public

# Application URL via PgBouncer Connection Pooler (transaction pool mode)
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@pgbouncer:6432/clinic_systems?schema=public&pgbouncer=true

# 2. Web & Domain Settings
NEXT_PUBLIC_PLATFORM_DOMAIN=clinicos.app
NEXT_PUBLIC_API_URL=https://clinicos.app/api
PORT=4000
NODE_ENV=production

# 3. Authentication & Security
JWT_SECRET=generate_a_cryptographically_secure_jwt_secret_min_32char
JWT_EXPIRES_IN=7d
SUPERADMIN_SECRET_KEY=generate_a_superadmin_secret_token_min_32char

# 4. HIPAA / GDPR Clinical PHI 256-bit Encryption Key (64-char Hex or raw passphrase)
CLINICAL_PHI_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 5. Telegram Dual-Bot Fleet Management
MASTER_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_MasterBotToken

# 6. Multi-Tenant Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. Platform KHQR Subscription Settlement
PLATFORM_BANK_ACCOUNT=clinicos_billing@aba
PLATFORM_MERCHANT_NAME=ClinicOS Health Tech
PLATFORM_CITY=Phnom Penh
PLATFORM_CURRENCY=USD
