generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  RECEPTIONIST
  CASHIER
  PHARMACIST
}

enum PlanTier {
  FREE
  STARTER_5
  PRO_8
  ENTERPRISE_12
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum VisitStatus {
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  KHQR
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

// -------------------------------------------------------------
// STEP 1: Multi-Tenant Core Models (SaaS Tenant & Subscriptions)
// -------------------------------------------------------------

model Tenant {
  id                 String             @id @default(uuid()) @db.Uuid
  slug               String             @unique // Subdomain e.g. "rotana", "vanna"
  clinicNameKh       String
  clinicNameEn       String
  mohLicenseNumber   String?
  clinicType         String?            @default("Polyclinic & Outpatient Center")
  phonePrimary       String?
  phoneEmergency     String?
  email              String?
  website            String?
  addressKh          String?            @db.Text
  addressEn          String?            @db.Text
  logoUrl            String?            @db.Text

  // Merchant Credentials (Bakong & ABA PayWay)
  bakongAccountId    String?            // e.g. "my_clinic@aba"
  merchantName       String?            // KHQR display merchant name
  merchantCity       String?            @default("Phnom Penh")
  paywayPaymentUrl   String?            // Optional ABA PayWay checkout URL e.g. "https://link.payway.com.kh/..."

  // SaaS Subscription Details
  planTier           PlanTier           @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd   DateTime?
  maxMonthlyPatients Int                @default(50)
  maxDailyKhqr       Int                @default(5)
  maxStaffAccounts   Int                @default(2)

  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Tenant Scoped Relations
  subscriptions      TenantSubscription[]
  users              User[]
  patients           Patient[]
  visits             Visit[]
  prescriptions      Prescription[]
  invoices           Invoice[]
  followUps          FollowUp[]
  auditLogs          AuditLog[]
  documents          Document[]
  visitorLogs        VisitorLog[]

  @@index([slug])
  @@index([planTier])
  @@index([subscriptionStatus])
  @@map("tenants")
}

model TenantSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  planTier       PlanTier
  amountUsd      Decimal            @db.Decimal(10, 2)
  status         SubscriptionStatus @default(ACTIVE)
  startDate      DateTime           @default(now())
  endDate        DateTime
  paymentTranId  String?            @unique
  paymentMethod  String?            @default("KHQR")
  invoiceNumber  String?            @unique
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("tenant_subscriptions")
}

// -------------------------------------------------------------
// STEP 2: Tenant Scoped Clinical Entities
// -------------------------------------------------------------

model User {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String?  @db.Uuid
  email                String   @unique
  passwordHash         String
  fullNameEn           String
  fullNameKh           String?
  role                 Role     @default(RECEPTIONIST)
  phone                String?
  avatarUrl            String?  @db.Text
  department           String?
  telegramUsername     String?
  bio                  String?
  notificationsEnabled Boolean  @default(true)
  isActive             Boolean  @default(true)
  expiresAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant              Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctorVisits        Visit[]          @relation("DoctorVisits")
  doctorPrescriptions Prescription[] @relation("DoctorPrescriptions")
  doctorFollowUps     FollowUp[]       @relation("DoctorFollowUps")
  cashierInvoices     Invoice[]        @relation("CashierInvoices")
  uploadedDocuments   Document[]       @relation("UploadedDocuments")
  auditLogs           AuditLog[]
  visitorLogs         VisitorLog[]

  @@index([tenantId])
  @@index([tenantId, id])
  @@index([tenantId, role])
  @@map("users")
}

model Patient {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String?   @db.Uuid
  patientCode           String    @unique
  nameEn                String
  nameKh                String?
  gender                Gender
  dob                   DateTime?
  phone                 String
  nationalId            String?
  address               String?
  bloodType             String?
  allergies             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits         Visit[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  invoices       Invoice[]
  followUps      FollowUp[]
  documents      Document[]

  @@index([tenantId])
  @@index([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([phone])
  @@index([nameEn])
  @@index([patientCode])
  @@map("patients")
}

model Visit {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String?     @db.Uuid
  visitCode       String      @unique
  patientId       String      @db.Uuid
  doctorId        String?     @db.Uuid
  reason          String?
  symptoms        String?
  bloodPressure   String?     // e.g. "120/80"
  heartRate       Int?        // bpm
  temperature     Decimal?    @db.Decimal(4, 1) // Celsius, e.g. 36.8
  weightKg        Decimal?    @db.Decimal(5, 2)
  heightCm        Decimal?    @db.Decimal(5, 2)
  diagnosis       String?
  notes           String?
  status          VisitStatus @default(WAITING)
  consultationFee Decimal     @default(5.00) @db.Decimal(10, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User?          @relation("DoctorVisits", fields: [doctorId], references: [id])
  medicalRecord MedicalRecord?
  prescriptions Prescription[]
  invoices      Invoice[]
  followUps     FollowUp[]
  documents     Document[]

  @@index([tenantId])
  @@index([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("visits")
}

model MedicalRecord {
  id            String   @id @default(uuid()) @db.Uuid
  visitId       String   @unique @db.Uuid
  patientId     String   @db.Uuid
  physicalExam  String?
  assessment    String?
  treatmentPlan String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  visit         Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("medical_records")
}

model Prescription {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String?            @db.Uuid
  prescriptionCode String             @unique
  visitId          String             @db.Uuid
  patientId        String             @db.Uuid
  doctorId         String             @db.Uuid
  status           PrescriptionStatus @default(PENDING)
  totalAmount      Decimal            @default(0.00) @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant           Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit            Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor           User               @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  items            PrescriptionItem[]

  @@index([tenantId])
  @@index([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([visitId])
  @@index([patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid()) @db.Uuid
  prescriptionId String       @db.Uuid
  medicineName   String
  dosage         String       // e.g. "500mg"
  frequency      String       // e.g. "3 times daily after food"
  duration       String       // e.g. "5 days"
  quantity       Int          @default(1)
  unitPrice      Decimal      @default(0.00) @db.Decimal(10, 2)
  subtotal       Decimal      @default(0.00) @db.Decimal(10, 2)
  instructions   String?
  createdAt      DateTime     @default(now())

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String?       @db.Uuid
  invoiceNumber String        @unique
  visitId       String?       @db.Uuid
  patientId     String        @db.Uuid
  totalAmount   Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0.00) @db.Decimal(10, 2)
  payableAmount Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD") // USD or KHR
  status        InvoiceStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(KHQR)
  cashierId     String?       @db.Uuid
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit         Visit?               @relation(fields: [visitId], references: [id])
  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  cashier       User?                @relation("CashierInvoices", fields: [cashierId], references: [id])
  transactions  PaymentTransaction[]

  @@index([tenantId])
  @@index([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([patientId])
  @@index([status])
  @@map("invoices")
}

model PaymentTransaction {
  id          String        @id @default(uuid()) @db.Uuid
  invoiceId   String        @db.Uuid
  tranId      String        @unique
  qrString    String        @db.Text
  md5         String
  currency    String        @default("USD")
  amount      Decimal       @db.Decimal(10, 2)
  status      PaymentStatus @default(PENDING)
  paywayLink  String?       @db.Text
  deeplinkUrl String?       @db.Text
  metadata    Json?
  verifiedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([md5])
  @@index([status])
  @@map("payment_transactions")
}

model FollowUp {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String?        @db.Uuid
  patientId     String         @db.Uuid
  doctorId      String         @db.Uuid
  visitId       String?        @db.Uuid
  scheduledDate DateTime
  reason        String
  status        FollowUpStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User           @relation("DoctorFollowUps", fields: [doctorId], references: [id])
  visit         Visit?         @relation(fields: [visitId], references: [id])

  @@index([tenantId])
  @@index([tenantId, id])
  @@index([tenantId, scheduledDate])
  @@index([patientId])
  @@index([scheduledDate])
  @@map("follow_ups")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([entity])
  @@map("audit_logs")
}

model Document {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @db.Uuid
  patientId    String   @db.Uuid
  visitId      String?  @db.Uuid
  title        String
  category     String   @default("LAB_REPORT") // LAB_REPORT, RADIOLOGY, REFERRAL, CERTIFICATE, OTHER
  fileType     String   // application/pdf, image/png, image/jpeg, etc.
  fileName     String
  fileSize     Int      // bytes
  fileUrl      String   @db.Text
  notes        String?
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit      Visit?   @relation(fields: [visitId], references: [id])
  uploadedBy User?    @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([patientId])
  @@index([category])
  @@map("documents")
}

model VisitorLog {
  id               BigInt   @id @default(autoincrement())
  tenantId         String?  @db.Uuid
  sessionId        String?
  ipAddress        String
  country          String?
  countryCode      String?
  city             String?
  region           String?
  isp              String?
  latitude         Float?
  longitude        Float?
  deviceType       String?
  os               String?
  browser          String?
  screenResolution String?
  language         String?
  path             String
  title            String?
  referrer         String?
  action           String   @default("PAGE_VIEW")
  userId           String?  @db.Uuid
  userEmail        String?
  userRole         String?
  userName         String?
  details          Json?
  createdAt        DateTime @default(now())

  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([ipAddress])
  @@index([path])
  @@index([action])
  @@index([createdAt])
  @@map("visitor_logs")
}
