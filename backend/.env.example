# ==============================================================================
# Houn Vannak Medical Clinic - Production Environment Configuration
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Connection-pooled URL for runtime queries (port 5432 or with -pooler)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct URL for Prisma migrations and schema push
DIRECT_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET="replace_with_a_secure_random_64_char_secret_key_in_production"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. Cloudinary Image & Document Storage
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
# Or provide the full CLOUDINARY_URL:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# ------------------------------------------------------------------------------
# 4. ABA PayWay & Bakong KHQR Settings
# ------------------------------------------------------------------------------
BAKONG_ACCOUNT_ID="rotana_clinic@aba"
BAKONG_MERCHANT_NAME="Houn Vannak Medical Clinic"
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_CURRENCY="USD"

# ------------------------------------------------------------------------------
# 5. Telegram Alert Bot Configuration (@Clinic_alertbot)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="8934642394:AAG-nzLq9Zr0DnMWgwkSgAE_HZdp1ddLn8s"
TELEGRAM_CHAT_ID="-1004328379441"
TELEGRAM_TOPIC_PAYMENTS="57"
TELEGRAM_TOPIC_QUEUE="69"
TELEGRAM_TOPIC_PHARMACY="59"
TELEGRAM_TOPIC_SECURITY="60"

# ------------------------------------------------------------------------------
# 6. CORS & Frontend Origin
# ------------------------------------------------------------------------------
FRONTEND_URL="https://houn-vannak-clinic.vercel.app"

# ------------------------------------------------------------------------------
# 7. Initial Seeding Passwords (Optional - used during prisma:seed)
# ------------------------------------------------------------------------------
SEED_ADMIN_PASSWORD="Rotana#Owner$2026!MasterKey"
SEED_DOCTOR_PASSWORD="Doctor#Password2026!"
SEED_RECEPTIONIST_PASSWORD="Reception#Password2026!"
SEED_CASHIER_PASSWORD="Cashier#Password2026!"
SEED_PHARMACIST_PASSWORD="Pharmacy#Password2026!"
